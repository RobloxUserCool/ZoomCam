<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFE22222" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="#FFE22222" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
